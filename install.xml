	private function ensureProbgBannerColumns() {
		$mobile_image = $this-&gt;db-&gt;query("SHOW COLUMNS FROM `" . DB_PREFIX . "banner_image` LIKE 'mobile_image'");

		if (!$mobile_image-&gt;num_rows) {
			$this-&gt;db-&gt;query("ALTER TABLE `" . DB_PREFIX . "banner_image` ADD `mobile_image` VARCHAR(255) NOT NULL DEFAULT '' AFTER `image`");
		}

		$hide_title = $this-&gt;db-&gt;query("SHOW COLUMNS FROM `" . DB_PREFIX . "banner_image` LIKE 'hide_title'");

		if (!$hide_title-&gt;num_rows) {
			$this-&gt;db-&gt;query("ALTER TABLE `" . DB_PREFIX . "banner_image` ADD `hide_title` TINYINT(1) NOT NULL DEFAULT '0' AFTER `mobile_image`");
