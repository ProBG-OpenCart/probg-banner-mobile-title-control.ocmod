{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-picture-o"></i> {{ heading_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_info }}</p>
        <p>
          <a href="{{ banner_url }}" class="btn btn-primary"><i class="fa fa-picture-o"></i> {{ text_banner_link }}</a>
          <a href="{{ modules_url }}" class="btn btn-default"><i class="fa fa-puzzle-piece"></i> {{ text_modules_link }}</a>
        </p>
      </div>
    </div>
  </div>
</div>
{{ footer }}
